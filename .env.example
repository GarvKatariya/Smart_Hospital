# Database
DATABASE_URL=sqlite:///./hospital.db
# For PostgreSQL: postgresql://user:password@localhost:5432/hospital_db

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM
GEMINI_API_KEY=your-gemini-api-key
LLM_PROVIDER=gemini

# Application
DEMO_MODE=true
DEBUG=true
HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# RAG
FAISS_INDEX_DIR=./rag/index
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
RETRIEVAL_TOP_K=5

# Hospital Config
TOTAL_HOSPITAL_BEDS=200
OCCUPANCY_WARNING_THRESHOLD=85
